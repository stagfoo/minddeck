<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- A launcher has to enumerate every launchable activity on the device.
         Android 11+ hides the package list behind this permission; it is
         Play-Store-restricted, but a launcher is one of the documented
         legitimate uses and this one is sideloaded anyway. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <application
        android:label="Rolidecks"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize"

            android:screenOrientation="portrait"

            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:excludeFromRecents="true"
            android:clearTaskOnLaunch="true"
            android:resumeWhilePausing="true">

            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />

            <!-- CATEGORY_HOME + CATEGORY_DEFAULT is what offers this app in
                 Settings > Apps > Default apps > Home app. CATEGORY_LAUNCHER
                 is kept as well so it can still be opened from the current
                 launcher's app drawer while it isn't the default yet — handy
                 during development, harmless afterwards. -->
            <!-- On the home activity, not an activity of its own. The system
                 resolves this against the default launcher's package, and
                 every launcher that works puts it here — a separate activity
                 was the one part of this that had no precedent. No DEFAULT
                 category: the system sends the action on its own. -->
            <intent-filter>
                <action android:name="android.content.pm.action.CONFIRM_PIN_SHORTCUT"/>
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.HOME"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>


        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>

    <queries>
        <!-- The launchable-activity query the app list is built from. Without
             it, queryIntentActivities returns only this app on Android 11+. -->
        <intent>
            <action android:name="android.intent.action.MAIN"/>
            <category android:name="android.intent.category.LAUNCHER"/>
        </intent>
    </queries>
</manifest>
